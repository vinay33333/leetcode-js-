/**
 * @param {string} s
 * @param {string} target
 * @return {string}
 */
var lexPalindromicPermutation = function(s, target) {
    const n = s.length;
    const freq = new Array(26).fill(0);
    for (let i = 0; i < n; i++) {
        freq[s.charCodeAt(i) - 97]++;
    }

    let oddCount = 0;
    let mid = -1;
    for (let i = 0; i < 26; i++) {
        if (freq[i] % 2 !== 0) {
            oddCount++;
            mid = i;
        }
    }

    if ((n % 2 === 0 && oddCount > 0) || (n % 2 !== 0 && oddCount > 1)) {
        return "";
    }

    for (let i = 0; i < 26; i++) {
        freq[i] = Math.floor(freq[i] / 2);
    }

    const half = Math.floor(n / 2);
    const ans = new Array(n);
    let pos = 0;

    while (pos < half) {
        let ch = target.charCodeAt(pos) - 97;
        if (freq[ch] === 0) {
            break;
        }
        ans[pos] = String.fromCharCode(97 + ch);
        freq[ch]--;
        pos++;
    }

    const makeFull = (arr) => {
        if (mid !== -1) {
            arr[half] = String.fromCharCode(97 + mid);
        }
        for (let i = 0; i < half; i++) {
            arr[n - 1 - i] = arr[i];
        }
        return arr.join('');
    };

    if (pos === half) {
        let full = makeFull([...ans]);
        if (full > target) {
            return full;
        }
    }
    while (true) {
        if (pos < half) {
            let minCh = target.charCodeAt(pos) - 97 + 1;
            let found = -1;
            for (let ch = minCh; ch < 26; ch++) {
                if (freq[ch] > 0) {
                    found = ch;
                    break;
                }
            }

            if (found !== -1) {
                ans[pos] = String.fromCharCode(97 + found);
                freq[found]--;
                let dst = pos + 1;
                for (let ch = 0; ch < 26; ch++) {
                    for (let off = 0; off < freq[ch]; off++) {
                        ans[dst + off] = String.fromCharCode(97 + ch);
                    }
                    dst += freq[ch];
                }
                return makeFull([...ans]);
            }
        }

        if (pos === 0) {
            return "";
        }
        pos--;
        let prevCh = target.charCodeAt(pos) - 97;
        freq[prevCh]++;
    }
};
